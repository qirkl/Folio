<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Folio.Desktop.App"
             RequestedThemeVariant="Default">

  <Application.Resources>
    <!-- Folio draws its own caption inside the page. Keep the decorations
         pipeline (it supplies the automatic resize hit testing) but give it
         no titlebar, no frame and no shadow, so the client area is the whole
         window and the acrylic can reach the rounded edge. -->
    <ControlTheme x:Key="{x:Type WindowDrawnDecorations}"
                  TargetType="WindowDrawnDecorations">
      <Setter Property="DefaultTitleBarHeight" Value="0" />
      <Setter Property="DefaultFrameThickness" Value="0" />
      <Setter Property="DefaultShadowThickness" Value="0" />
      <Setter Property="Template">
        <WindowDrawnDecorationsTemplate>
          <WindowDrawnDecorationsContent>
            <WindowDrawnDecorationsContent.Underlay>
              <Panel Background="Transparent" />
            </WindowDrawnDecorationsContent.Underlay>
            <WindowDrawnDecorationsContent.Overlay>
              <Panel Background="Transparent" />
            </WindowDrawnDecorationsContent.Overlay>
          </WindowDrawnDecorationsContent>
        </WindowDrawnDecorationsTemplate>
      </Setter>
    </ControlTheme>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

</Application>
